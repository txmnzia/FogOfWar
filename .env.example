# ---- Fog of War configuration ----
# Copy this file to `.env` and fill in the three values below.
# All of these are *public* client keys (they ship to the browser) — do NOT
# put the Supabase service_role key here.

# MapTiler — free account at https://cloud.maptiler.com/account/keys/
# Powers the parchment vector map tiles AND place-name search (geocoding).
VITE_MAPTILER_KEY=

# Supabase — create a project at https://supabase.com/dashboard
# Settings -> API -> "Project URL" and "anon public" key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
