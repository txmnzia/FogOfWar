# ---- Fog of War configuration ----
# Copy this file to `.env` and fill in the two values below.
# Both are *public* client values (they ship to the browser) — do NOT put the
# Supabase service_role key here.
#
# The map (OpenFreeMap) and place search (Nominatim) are keyless — nothing to
# configure for those.

# Supabase — create a project at https://supabase.com/dashboard
# Settings -> API -> "Project URL" and "anon public" key.
# Handles cross-device sync and your magic-link login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
